#!/usr/bin/env bash
set -euo pipefail

# --- Config ---
SERVER_NAME="${SERVER_NAME:-xnet-public}"
SERVER_TYPE="${SERVER_TYPE:-cpx51}"
LOCATION="${LOCATION:-hil}"
IMAGE="${IMAGE:-ubuntu-24.04}"
SSH_KEY_NAME="${SSH_KEY_NAME:-insipx-hetzner}"
FLOATING_IP_NAME="${FLOATING_IP_NAME:-xmtp-migration-test-west}"
SSH_KEY_PATH="${SSH_KEY_PATH:?SSH_KEY_PATH must be set}"
FLAKE_REF="${FLAKE_REF:-.#public-xnet}"
CUTOVER_DELAY_MINUTES="${CUTOVER_DELAY_MINUTES:-240}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Prereqs ---
for cmd in hcloud nixos-anywhere jq ssh; do
  if ! command -v "$cmd" &>/dev/null; then
    echo "ERROR: $cmd not found" >&2
    exit 1
  fi
done

if [ -z "${HCLOUD_TOKEN:-}" ]; then
  echo "ERROR: HCLOUD_TOKEN not set" >&2
  exit 1
fi

if [ ! -f "$SSH_KEY_PATH" ]; then
  echo "ERROR: SSH key not found at '${SSH_KEY_PATH}'" >&2
  exit 1
fi

# --- Compute cutover timestamp ---
NS=1000000000
NOW_S=$(date -u +%s)
CUTOVER_S=$(( NOW_S + CUTOVER_DELAY_MINUTES * 60 ))
CUTOVER_TS=$(( CUTOVER_S * NS ))
echo ":: Cutover scheduled for:"
echo "::   UTC: $(date -u -d @${CUTOVER_S} '+%Y-%m-%d %H:%M')"
echo "::   EST: $(TZ='America/New_York' date -d @${CUTOVER_S} '+%Y-%m-%d %H:%M %Z')"
echo "::   CST: $(TZ='America/Chicago' date -d @${CUTOVER_S} '+%Y-%m-%d %H:%M %Z')"
echo "::   PST: $(TZ='America/Los_Angeles' date -d @${CUTOVER_S} '+%Y-%m-%d %H:%M %Z')"
echo "::   CET: $(TZ='Europe/Berlin' date -d @${CUTOVER_S} '+%Y-%m-%d %H:%M %Z')"
echo "::   JST: $(TZ='Asia/Tokyo' date -d @${CUTOVER_S} '+%Y-%m-%d %H:%M %Z')"

# --- Get floating IP address ---
FLOATING_IP=$(hcloud floating-ip describe "$FLOATING_IP_NAME" -o json | jq -r '.ip')
if [ -z "$FLOATING_IP" ] || [ "$FLOATING_IP" = "null" ]; then
  echo "ERROR: Could not resolve floating IP '$FLOATING_IP_NAME'" >&2
  exit 1
fi
echo ":: Floating IP: ${FLOATING_IP}"

# --- Teardown previous instance ---
echo ":: Tearing down previous instance..."
hcloud server delete "$SERVER_NAME" 2>/dev/null || true

# --- Create server ---
echo ":: Creating server ${SERVER_NAME} (${SERVER_TYPE} in ${LOCATION})..."
hcloud server create \
  --name "$SERVER_NAME" \
  --type "$SERVER_TYPE" \
  --location "$LOCATION" \
  --image "$IMAGE" \
  --ssh-key "$SSH_KEY_NAME"

# --- Assign floating IP ---
echo ":: Assigning floating IP ${FLOATING_IP_NAME} to ${SERVER_NAME}..."
hcloud floating-ip assign "$FLOATING_IP_NAME" "$SERVER_NAME"

# --- Wait for SSH (use primary IP) ---
SERVER_IP=$(hcloud server ip "$SERVER_NAME")
echo ":: Waiting for SSH on ${SERVER_IP} (primary IP)..."
echo ":: Clearing old SSH host keys..."
ssh-keygen -R "$SERVER_IP" 2>/dev/null || true
ssh-keygen -R "$FLOATING_IP" 2>/dev/null || true
echo ":: Giving cloud-init 30s to finish..."
sleep 30
SSH_READY=false
for i in $(seq 1 30); do
  if ssh -o StrictHostKeyChecking=no -o ConnectTimeout=15 -o BatchMode=yes \
    -i "$SSH_KEY_PATH" root@"$SERVER_IP" true 2>/dev/null; then
    SSH_READY=true
    break
  fi
  sleep 5
done

if [ "$SSH_READY" != "true" ]; then
  echo "ERROR: SSH not ready after 60 seconds" >&2
  exit 1
fi

# --- Prepare extra-files ---
EXTRA_DIR=$(mktemp -d)
trap 'rm -rf "$EXTRA_DIR"' EXIT
mkdir -p "$EXTRA_DIR/etc/xnet"
echo "XNET_CUTOVER_TIMESTAMP=${CUTOVER_TS}" > "$EXTRA_DIR/etc/xnet/cutover-env"
if [ -n "${SLACK_WEBHOOK_URL:-}" ]; then
  echo "SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}" >> "$EXTRA_DIR/etc/xnet/cutover-env"
fi

# --- Deploy NixOS ---
LOG_FILE="${LOG_DIR:-./xnet-logs}/provision-$(date +%Y%m%d-%H%M%S).log"
mkdir -p "$(dirname "$LOG_FILE")"
echo ":: Deploying NixOS via nixos-anywhere (logging to ${LOG_FILE})..."
nixos-anywhere \
  --flake "$FLAKE_REF" \
  --extra-files "$EXTRA_DIR" \
  -i "$SSH_KEY_PATH" \
  --ssh-option "StrictHostKeyChecking=no" \
  --ssh-option "ServerAliveInterval=60" \
  --ssh-option "ServerAliveCountMax=20" \
  --ssh-option "ConnectTimeout=60" \
  --debug \
  root@"$SERVER_IP" 2>&1 | tee "$LOG_FILE"

# --- Wait for reboot and services ---
echo ":: Waiting for xnet to start (using floating IP ${FLOATING_IP})..."
sleep 15  # give nixos-anywhere reboot time + floating IP to propagate
for i in $(seq 1 60); do
  if ssh -o StrictHostKeyChecking=no -o BatchMode=yes -i "$SSH_KEY_PATH" root@"$FLOATING_IP" \
    "systemctl is-active xnet.service" 2>/dev/null; then
    echo ":: xnet is running"
    break
  fi
  echo "   waiting... ($i)"
  sleep 10
done

echo ""
echo "========================================="
echo "  Server:   ${FLOATING_IP}"
echo "  SSH:      ssh -i ${SSH_KEY_PATH} root@${FLOATING_IP}"
echo "  Cutover:  $(date -u -d @${CUTOVER_S} '+%Y-%m-%d %H:%M UTC')"
echo "  Status:   http://migrate.xmtp.run"
echo "========================================="
